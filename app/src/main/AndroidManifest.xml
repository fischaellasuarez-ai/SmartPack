<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/backpack"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPack">

        <activity
            android:name=".activity_teacher_main_dashboard"
            android:exported="true"
            android:theme="@style/Theme.SmartPack">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".activity_all_requirements_teacher_main_dashboard"
            android:exported="false"
            android:theme="@style/Theme.SmartPack" />

        <activity
            android:name=".activity_teacher_profile"
            android:exported="false"
            android:theme="@style/Theme.SmartPack" />

        <activity
            android:name=".activity_uploading_section"
            android:exported="false"
            android:theme="@style/Theme.SmartPack" />

    </application>

</manifest>
