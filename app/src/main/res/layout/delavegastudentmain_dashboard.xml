<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="8dp"
    android:background="#14C9C9">

    <!-- Top logo area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#B9F5DF"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎒"
            android:textSize="76sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SmartPack"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#172B70" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your smart school companion"
            android:textSize="14sp"
            android:textColor="#31534F" />

    </LinearLayout>

    <!-- Status selection area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:background="#20396F">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Your\nStatus"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#B9FF58"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <Button
                android:id="@+id/studentButton"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="🎓\nStudent"
                android:textAllCaps="false"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#102B70"
                android:backgroundTint="#00D4B4" />

            <Button
                android:id="@+id/teacherButton"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="👩‍🏫\nTeacher"
                android:textAllCaps="false"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#102B70"
                android:backgroundTint="#32BDCF" />

        </LinearLayout>

        <TextView
            android:id="@+id/statusMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Select your role to continue"
            android:textSize="14sp"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>