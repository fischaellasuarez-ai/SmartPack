
    <?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF7FC"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/background"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/logoImage"
                    android:layout_width="38dp"
                    android:layout_height="46dp"
                    android:src="@drawable/smartpack_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="SmartPack logo"
                    tools:ignore="ImageContrastCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SmartPack"
                    android:textColor="#173A91"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- TODAY'S OVERVIEW -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="6dp"
                app:cardBackgroundColor="#FFF4D8"
                app:cardCornerRadius="13dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/overviewIcon"
                        android:layout_width="29dp"
                        android:layout_height="36dp"
                        android:contentDescription="Requirements overview"
                        android:src="@drawable/pic7"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/overviewTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Today's Overview"
                        android:textColor="#252525"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/overviewIcon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/viewAllButton" />

                    <TextView
                        android:id="@+id/overviewDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Here's what's happening in your\nclass today."
                        android:textColor="#444444"
                        android:textSize="9sp"
                        app:layout_constraintStart_toEndOf="@id/overviewIcon"
                        app:layout_constraintTop_toBottomOf="@id/overviewTitle"
                        app:layout_constraintEnd_toStartOf="@id/viewAllButton" />

                    <Button
                        android:id="@+id/viewAllButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="View All >"
                        android:textAllCaps="false"
                        android:textColor="#111111"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:backgroundTint="#8FE8E8"
                        app:cornerRadius="9dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- CLASS OVERVIEW -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="106dp"
                android:layout_marginBottom="7dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Class overview"
                        android:textColor="#202020"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <!-- CLASSES -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="37dp"
                                android:layout_height="37dp"
                                android:background="@drawable/bg_circle_green"
                                android:src="@drawable/pic3"
                                android:scaleType="fitCenter"
                                android:contentDescription="human_icon" />

                            <TextView
                                android:id="@+id/classesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="8"
                                android:textColor="#21A876"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Classes"
                                android:textColor="#222222"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <!-- REQUIREMENTS -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="37dp"
                                android:layout_height="37dp"
                                android:background="@drawable/yellow_circle"
                                android:gravity="center"
                                android:text="▤"
                                android:textColor="#725B15"
                                android:textSize="22sp" />

                            <TextView
                                android:id="@+id/requirementsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="12"
                                android:textColor="#FF9900"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Requirements Sent"
                                android:textColor="#222222"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <!-- STUDENTS READY -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/pic10"
                                android:layout_width="38dp"
                                android:layout_height="33dp"
                                android:contentDescription="Backpack reminder"
                                android:scaleType="centerCrop"
                                android:src="@drawable/pic10"
                                app:shapeAppearanceOverlay="@style/CircleImage"
                                app:strokeColor="#3AAB83"
                                app:strokeWidth="1dp" />

                            <TextView
                                android:id="@+id/studentsReadyCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="67%"
                                android:textColor="#B94DE1"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Students Ready"
                                android:textColor="#222222"
                                android:textSize="9sp" />

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CREATE REQUIREMENT -->
            <androidx.cardview.widget.CardView
                android:id="@+id/createRequirementCard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="7dp"
                app:cardBackgroundColor="#0750AD"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

            </androidx.cardview.widget.CardView>

            <!-- RECENT SENT REQUIREMENTS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="13dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="336dp"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="97dp">

                        <TextView
                            android:id="@+id/recentTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recent Sent Requirements"
                            android:textColor="#222222"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/recentViewAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View All >"
                            android:textColor="#21A876"
                            android:textSize="8sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- REQUIREMENT 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="31dp"
                            android:layout_height="31dp"
                            android:background="#E7E0F1"
                            android:gravity="center"
                            android:text="📄"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="140dp"
                                android:padding="5dp">

                                <TextView
                                    android:layout_width="28dp"
                                    android:layout_height="34dp"
                                    android:background="#FFFFFF"
                                    android:gravity="center"
                                    android:text="☷"
                                    android:textColor="#0750AD"
                                    android:textSize="23sp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:text="Create Requirement"
                                    android:textColor="#FFFFFF"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    app:layout_constraintStart_toEndOf="@id/createRequirementCard"
                                    tools:ignore="NotSibling" />

                                <TextView
                                    android:id="@+id/createRequirementTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:text="Create Requirement"
                                    android:textColor="#FFFFFF"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    app:layout_constraintStart_toEndOf="@id/createRequirementCard"
                                    tools:ignore="NotSibling" />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Gen Science - Activity #3"
                                android:textColor="#292929"
                                android:textSize="8sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sent today at 7:23 AM"
                                android:textColor="#777777"
                                android:textSize="7sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="15dp"
                            android:background="@drawable/background2"
                            android:gravity="center"
                            android:text="27/45 READY"
                            android:textColor="#188A9C"
                            android:textSize="6sp" />

                        <TextView
                            android:layout_width="18dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text=">"
                            android:textColor="#222222"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- REQUIREMENT 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="31dp"
                            android:layout_height="31dp"
                            android:background="#F0E0E0"
                            android:gravity="center"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Cied - Reflection Worksheet"
                                android:textColor="#292929"
                                android:textSize="8sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sent yesterday"
                                android:textColor="#777777"
                                android:textSize="7sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="15dp"
                            android:background="@drawable/background2"
                            android:gravity="center"
                            android:text="20/45 READY"
                            android:textColor="#188A9C"
                            android:textSize="6sp" />

                        <TextView
                            android:layout_width="18dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text=">"
                            android:textColor="#222222"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- REQUIREMENT 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="31dp"
                            android:layout_height="31dp"
                            android:background="#E0E8E8"
                            android:drawableBottom="@drawable/pic11"
                            android:gravity="center"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Gen Math - Project Requirements"
                                android:textColor="#292929"
                                android:textSize="8sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sent 2 days ago"
                                android:textColor="#777777"
                                android:textSize="7sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="15dp"
                            android:background="@drawable/background2"
                            android:gravity="center"
                            android:text="42/45 READY"
                            android:textColor="#188A9C"
                            android:textSize="6sp" />

                        <TextView
                            android:layout_width="18dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text=">"
                            android:textColor="#222222"
                            android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- REMINDER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="172dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="5dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/reminderImage"
                    android:layout_width="107dp"
                    android:layout_height="107dp"
                    android:contentDescription="Backpack reminder"
                    android:scaleType="centerCrop"
                    android:src="@drawable/backpack"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:strokeColor="#3AAB83"
                    app:strokeWidth="1dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REMINDER:"
                        android:textColor="#3AAB83"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Double check and make sure your\nstudents are ready!"
                        android:textColor="#202020"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#4BD0D2"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/home_icon"
            android:scaleType="fitCenter"
            android:padding="11dp"
            android:contentDescription="Home"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/addButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Add requirement"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_plus"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/profileButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/human_icon"
            android:scaleType="fitCenter"
            android:padding="11dp"
            android:contentDescription="Profile"
            app:tint="#000000" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
