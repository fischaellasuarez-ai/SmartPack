<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF7FC"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- BOTTOM NAVIGATION -->
    <ScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/logoImage"
                    android:layout_width="61dp"
                    android:layout_height="77dp"
                    android:contentDescription="SmartPack logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/smartpack_logo"
                    tools:ignore="ImageContrastCheck" />

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginBottom="6dp"
                app:cardBackgroundColor="#FFF4D8"
                app:cardCornerRadius="13dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/pic7"
                        app:shapeAppearanceOverlay="@style/CircleImage" />

                    <TextView
                        android:id="@+id/overviewTitle"
                        android:layout_width="219dp"
                        android:layout_height="25dp"
                        android:layout_marginEnd="8dp"
                        android:text="Today's Overview"
                        android:textColor="#252525"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/viewAllButton"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/overviewContent"
                        android:layout_width="202dp"
                        android:layout_height="35dp"
                        android:layout_marginEnd="24dp"
                        android:text="Here’s what’s happening in your class today."
                        android:textColor="#444444"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toStartOf="@id/viewAllButton"
                        tools:layout_editor_absoluteY="31dp" />

                    <Button
                        android:id="@+id/viewAllButton"
                        android:layout_width="80dp"
                        android:layout_height="35dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#8FE8E8"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="View All >"
                        android:textAllCaps="false"
                        android:textColor="#111111"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="9dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.518" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="161dp"
                android:layout_marginBottom="7dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Class overview"
                        android:textColor="#202020"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="3">


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/pic4"
                                app:shapeAppearanceOverlay="@style/CircleImage"
                                app:strokeColor="#F6E8B0" />

                            <TextView
                                android:id="@+id/classesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="8"
                                android:textColor="#21A876"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Classes"
                                android:textColor="#222222"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/pic3"
                                app:shapeAppearanceOverlay="@style/CircleImage"
                                app:strokeColor="#BED7CE" />


                            <TextView
                                android:id="@+id/requirementsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="12"
                                android:textColor="#FF9900"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Requirements Sent"
                                android:textColor="#222222"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/pic10"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/pic5"
                                app:shapeAppearanceOverlay="@style/CircleImage"
                                app:strokeColor="#3AAB83" />

                            <TextView
                                android:id="@+id/studentsReadyCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="67%"
                                android:textColor="#B94DE1"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Students Ready"
                                android:textColor="#222222"
                                android:textSize="9sp" />

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/createRequirementCard"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginBottom="7dp"
                app:cardBackgroundColor="#0750AD"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/iconContainer"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <!-- Base Document Icon -->
                        <ImageView
                            android:id="@+id/myImage"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:contentDescription="Document Icon"
                            android:src="@drawable/folder_icon"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/plusIcon"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:contentDescription="Add Badge"
                            android:src="@drawable/plus_icon"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:shapeAppearanceOverlay="@style/CircleImage" />


                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/overviewTitle3"
                        android:layout_width="268dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:text="Create Requirement"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@id/textView8"
                        app:layout_constraintEnd_toStartOf="@id/arrowIcon"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toEndOf="@id/iconContainer"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_setVerticalChainStyle="packed" />

                    <TextView
                        android:id="@+id/textView8"
                        android:layout_width="264dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:text="Add and send requirements to your classes."
                        android:textColor="#E0E0E0"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/overviewTitle3"
                        app:layout_constraintHorizontal_bias="1.0"
                        app:layout_constraintStart_toStartOf="@id/overviewTitle3"
                        app:layout_constraintTop_toBottomOf="@id/overviewTitle3" />

                    <TextView
                        android:id="@+id/arrowIcon"
                        android:layout_width="22dp"
                        android:layout_height="37dp"
                        android:text="&gt;"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.518" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="13dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="264dp"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp">

                        <TextView
                            android:id="@+id/recentTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Recent Sent Requirements"
                            android:textColor="#222222"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.105" />

                        <TextView
                            android:id="@+id/recentViewAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View All >"
                            android:textColor="#21A876"
                            android:textSize="20sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="57dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/gen_sci"
                            app:shapeAppearanceOverlay="@style/CircleImage"
                            app:strokeColor="#3AAB83" />


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Gen science- Activity #3"
                                android:textColor="#292929"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="sent today at 7:23 AM"
                                android:textColor="#777777"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="15dp"
                            android:background="@drawable/background2"
                            android:gravity="center"
                            android:text="20/45 READY"
                            android:textColor="#188A9C"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="18dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text=">"
                            android:textColor="#222222"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="71dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/cled"
                            app:shapeAppearanceOverlay="@style/CircleImage"
                            app:strokeColor="#3AAB83" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Cied - Reflection Worksheet"
                                android:textColor="#292929"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sent yesterday"
                                android:textColor="#777777"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="70dp"
                            android:layout_height="15dp"
                            android:background="@drawable/background2"
                            android:gravity="center"
                            android:text="20/45 READY"
                            android:textColor="#188A9C"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="15dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text=">"
                            android:textColor="#222222"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/gen_math"
                            app:shapeAppearanceOverlay="@style/CircleImage"
                            app:strokeColor="#3AAB83" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Gen math- materials needed"
                                android:textColor="#292929"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sent 2 days ago"
                                android:textColor="#777777"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="66dp"
                            android:layout_height="15dp"
                            android:background="@drawable/background2"
                            android:gravity="center"
                            android:text="20/45 READY"
                            android:textColor="#188A9C"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="18dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text=">"
                            android:textColor="#222222"
                            android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="392dp"
                android:layout_height="94dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="5dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/reminderIconContainer"
                    android:layout_width="74dp"
                    android:layout_height="69dp">


                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/reminderImage"
                        android:layout_width="80dp"
                        android:layout_height="68dp"
                        android:contentDescription="Backpack reminder"
                        android:scaleType="centerCrop"
                        android:src="@drawable/backpack"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        app:strokeColor="#3AAB83" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/checkBadge"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="Checkmark"
                        android:src="@drawable/check_icon"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:shapeAppearanceOverlay="@style/CircleImage" />


                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="232dp"
                    android:layout_height="81dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="232dp"
                        android:layout_height="wrap_content"
                        android:text="REMINDER:"
                        android:textColor="#3AAB83"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="232dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Double check and make sure your students are ready!"
                        android:textColor="#202020"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="411dp"
        android:layout_height="100dp"
        android:layout_marginTop="839dp"
        android:background="#4BD0D2"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/backgroundImage">


        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="20dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Home"
            android:padding="1dp"
            android:scaleType="fitCenter"
            android:src="@drawable/home_icon"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/plusButton"
            android:layout_width="1dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Add requriments"
            android:padding="1dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_plus"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/profileButton"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Profile"
            android:padding="1dp"
            android:scaleType="fitCenter"
            android:src="@drawable/human_icon"
            app:tint="#000000" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
