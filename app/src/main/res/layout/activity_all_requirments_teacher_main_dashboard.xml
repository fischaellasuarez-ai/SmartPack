<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EAF7FC">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SMART-PACK"
        android:textColor="#0049AC"
        android:textSize="25sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="22dp"
        android:paddingBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="All Requirements"
        android:textColor="#0750AD"
        android:textSize="21sp"
        android:textStyle="bold"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/requirementsCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 Requirements Sent"
        android:textColor="#555555"
        android:textSize="14sp"
        android:paddingStart="20dp"
        android:paddingBottom="12dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/requirementsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"/>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#4FD1D9"
        android:elevation="8dp">

        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/home_icon"
            android:background="@android:color/transparent"
            android:contentDescription="Home"
            android:scaleType="centerInside"
            android:padding="16dp"/>

        <ImageButton
            android:id="@+id/addClasses_Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/icon_plus"
            android:background="@android:color/transparent"
            android:contentDescription="Add Requirement"
            android:scaleType="centerInside"
            android:padding="16dp"/>

        <ImageButton
            android:id="@+id/profileButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/human_icon"
            android:background="@android:color/transparent"
            android:contentDescription="Profile"
            android:scaleType="centerInside"
            android:padding="16dp"/>

    </LinearLayout>

</LinearLayout>